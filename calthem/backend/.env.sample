# ---- CALTHEM backend configuration ----

# Adapter: "mock" (no credentials, simulated caller) or "bolna" (real calls)
TELEPHONY_ADAPTER=mock

# Database (SQLite by default; swap for Postgres in production)
CALTHEM_DB_URL=sqlite:///./calthem.db

# LLM for instruction->schema generation (optional in mock mode).
# If unset, a robust offline heuristic is used instead.
OPENAI_API_KEY=
CALTHEM_SCHEMA_MODEL=gpt-4o-mini

# Bulk queue tuning
CALTHEM_MAX_CONCURRENCY=1
CALTHEM_MAX_RETRIES=1
CALTHEM_RETRY_DELAY_SECONDS=30

# Regional phone default (E.164). IN = India (+91) for the exhibition.
CALTHEM_DEFAULT_REGION=IN

# CORS (frontend origin)
CALTHEM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Only needed when TELEPHONY_ADAPTER=bolna ----
BOLNA_API_URL=http://localhost:5001
TELEPHONY_API_URL=http://localhost:8001
# Public URL where Bolna posts call results back to Calthem (use ngrok in dev)
CALTHEM_WEBHOOK_BASE=http://localhost:8080
